{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out",
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["electron/shared/*"],
      "@main/*": ["electron/main/*"],
      "@preload/*": ["electron/preload/*"]
    },
    "types": ["node"],
    "allowImportingTsExtensions": false
  },
  "include": [
    "./main/**/*.ts",
    "./preload/**/*.ts",
    "./shared/**/*.ts"
  ]
}
