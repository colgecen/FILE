#!/usr/bin/env bash
#
# file — uygulamayı çalıştırma ve paket derleme aracı
#
# Kullanım:
#   ./file                      -> uygulamayı kaynaktan çalıştır (Ctrl+C ile durdur)
#   ./file --build              -> etkileşimli menü (OS seç -> format seç -> derle)
#   ./file --list               -> tüm derleme seçeneklerini listele
#   ./file linux appimage       -> hızlı derle (argümanlı, menüsüz)
#   ./file --tam linux appimage  -> tam derle (doğrulama zincirli)
#   ./file windows portable
#   ./file macos dmg
#   ./file --install            -> `file` komutunu ve masaüstü kısayolunu kur
#   ./file --uninstall          -> komutu, kısayolu ve simgeyi kaldır
#   ./file --help               -> yardım
#
# Geçerli hedefler (package.json > build alanıyla birebir):
#   linux   : appimage | deb | rpm | targz
#   windows : nsis | portable | zip
#   macos   : dmg | zip
#
set -euo pipefail

# ROOT = bu scriptin bulunduğu repo kökü. $0 symlink (örn. ~/.local/bin)
# üzerinden çağrılabilir, o yüzden tüm symlink'ler çözülür.
resolve_root() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}
ROOT="$(resolve_root)"

export PATH="$HOME/node/bin:$PATH"

VERSION="$(node -p "require('$ROOT/package.json').version" 2>/dev/null || echo bilinmiyor)"

# Hızlı mod varsayılandır: doğrulama zinciri atlanır.
# --tam verilirse typecheck + lint + test de çalışır.
FAST=1
ARGS=()
for a in "$@"; do
  case "$a" in
    --tam) FAST=0 ;;
    --fast|-f) FAST=1 ;;
    *) ARGS+=("$a") ;;
  esac
done
if [ "${#ARGS[@]}" -gt 0 ]; then
  set -- "${ARGS[@]}"
else
  set --
fi

banner() {
  echo "=============================================="
  echo "  Derleme araci  v$VERSION"
  echo "=============================================="
}

usage() {
  banner
  echo
  echo "Kullanım:"
  echo "  ./file                      Uygulamayı kaynaktan çalıştır"
  echo "  ./file --build              Etkileşimli derleme menüsü"
  echo "  ./file <os> <format>        Direkt hızlı derle"
  echo "  ./file --tam <os> <format>  Tam derle (doğrulama zincirli)"
  echo "  ./file --list               Seçenekleri listele"
  echo "  ./file --install            Komutu ve masaüstü kısayolunu kur"
  echo "  ./file --uninstall          Kurulumu kaldır"
  echo "  ./file --help               Bu yardım"
  echo
  echo "Hedefler:"
  echo "  linux   : appimage | deb | rpm | targz"
  echo "  windows : nsis | portable | zip"
  echo "  macos   : dmg | zip"
  echo
  echo "Örnekler:"
  echo "  ./file linux appimage"
  echo "  ./file --tam linux appimage"
  echo "  ./file windows portable"
  echo
  echo "Not: varsayılan hızlıdır (doğrulama atlanır). --tam ile typecheck"
  echo "+ lint + test zinciri de çalışır. Çıktı kısa tutulur; hata olursa"
  echo "tam log ekrana dökülür."
  echo "Windows/macOS paketleri Linux üstünde ek araç isteyebilir (wine vb.)."
}

list_targets() {
  echo "linux   : appimage | deb | rpm | targz"
  echo "windows : nsis | portable | zip"
  echo "macos   : dmg | zip"
}

# Uygulamayı kaynaktan başlat; Ctrl+C doğrudan uygulamaya ulaşır.
run_app() {
  cd "$ROOT"
  exec npm run dev -- "$@"
}

WRAPPER_MARK="# file-wrapper"
DESKTOP_MARK="# file-desktop"
ICON="$ROOT/assets/icon.png"

refresh_caches() {
  command -v update-desktop-database >/dev/null 2>&1 \
    && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
  command -v gtk-update-icon-cache >/dev/null 2>&1 \
    && gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
}

# Simge zaten yuvarlatılmışsa olduğu gibi kopyala; kare ise %20 köşe yuvarlat.
prepare_icon() {
  local dest="$1" im="" ident="" w r corner
  [ -f "$ICON" ] || return 1
  if command -v magick >/dev/null 2>&1; then
    im="magick"; ident="magick identify"
  elif command -v convert >/dev/null 2>&1; then
    im="convert"; ident="identify"
  fi
  if [ -z "$im" ]; then
    cp "$ICON" "$dest"
    return 0
  fi
  w="$($ident -format '%w' "$ICON")"
  r=$(( w * 20 / 100 ))
  corner="$($ident -format '%[fx:p{0,0}.a]' "$ICON" 2>/dev/null || echo 1)"
  if [ "$corner" = "0" ]; then
    cp "$ICON" "$dest"
  else
    $im "$ICON" -alpha set \
      \( -size "${w}x${w}" xc:none -fill white \
         -draw "roundrectangle 0,0 $((w-1)),$((w-1)) $r,$r" \) \
      -compose DstIn -composite "$dest"
  fi
}

install_desktop() {
  local apps="$HOME/.local/share/applications"
  local icons="$HOME/.local/share/icons/hicolor/512x512/apps"
  mkdir -p "$apps" "$icons"
  prepare_icon "$icons/file.png" || true
  cat > "$apps/file.desktop" << DESKTOP
$DESKTOP_MARK
[Desktop Entry]
Type=Application
Name=FILE
Comment=Keyboard-first desktop code editor
Exec="$ROOT/file"
Icon=file
Terminal=true
Categories=Development;
DESKTOP
  refresh_caches
  echo "Kuruldu: $apps/file.desktop (uygulama menüsünde görünür)"
}

uninstall_desktop() {
  local entry="$HOME/.local/share/applications/file.desktop"
  if [ -f "$entry" ] && grep -q "$DESKTOP_MARK" "$entry"; then
    rm -f "$entry"
    echo "Kaldırıldı: $entry"
  fi
  rm -f "$HOME/.local/share/icons/hicolor/512x512/apps/file.png"
  refresh_caches
}

do_install() {
  local bindir="$HOME/.local/bin" wrapper="$HOME/.local/bin/file"
  mkdir -p "$bindir"
  # Eski sembolik bağ hedef betiği ezmesin diye önce kaldır.
  if [ -L "$wrapper" ]; then
    rm -f "$wrapper"
  fi
  printf '#!/usr/bin/env bash\n%s\nexec "%s/file" --build "$@"\n' \
    "$WRAPPER_MARK" "$ROOT" > "$wrapper"
  chmod +x "$wrapper"
  echo "Kuruldu: $wrapper"
  install_desktop
  case ":$PATH:" in
    *":$bindir:"*) echo "PATH zaten '$bindir' içeriyor. Artık her klasörden 'file' yazabilirsin." ;;
    *)
      echo "NOT: '$bindir' PATH'te yok. Şu satırı ~/.bashrc'ye ekle:"
      echo "  export PATH=\"\$HOME/.local/bin:\$PATH\""
      echo "Sonra yeni terminal aç ya da: source ~/.bashrc"
      ;;
  esac
}

do_uninstall() {
  local wrapper="$HOME/.local/bin/file"
  if [ -f "$wrapper" ] && grep -q "$WRAPPER_MARK" "$wrapper"; then
    rm -f "$wrapper"
    echo "Kaldırıldı: $wrapper"
  elif [ -L "$wrapper" ]; then
    rm -f "$wrapper"
    echo "Kaldırıldı: $wrapper"
  else
    echo "Kaldırılacak komut bulunamadı."
  fi
  uninstall_desktop
}

# verify: paketleme öncesi doğrulama zinciri (hızlı modda atlanır)
verify() {
  if [ "$FAST" = "1" ]; then
    echo "==> Hızlı mod: doğrulama atlandı."
    return 0
  fi
  echo "==> Doğrulama zinciri çalışıyor (typecheck + lint + test)..."
  (cd "$ROOT" && npm run typecheck)
  (cd "$ROOT" && npm run lint)
  (cd "$ROOT" && npm test)
  echo "==> Doğrulama temiz."
}

build_target() {
  local os="$1" fmt="$2"
  local log="/tmp/file-derleme.log"
  : > "$log"
  # Önce hedefi doğrula; boşa derleme çalışmasın.
  local args=()
  case "$os" in
    linux)
      case "$fmt" in
        appimage) args=(--linux AppImage) ;;
        deb) args=(--linux deb) ;;
        rpm) args=(--linux rpm) ;;
        targz) args=(--linux tar.gz) ;;
        *)
          echo "Bilinmeyen linux formatı: $fmt (geçerli: appimage | deb | rpm | targz)"
          exit 1
          ;;
      esac
      ;;
    windows)
      case "$fmt" in
        nsis) args=(--win nsis) ;;
        portable) args=(--win portable) ;;
        zip) args=(--win zip) ;;
        *)
          echo "Bilinmeyen windows formatı: $fmt (geçerli: nsis | portable | zip)"
          exit 1
          ;;
      esac
      ;;
    macos|darwin)
      case "$fmt" in
        dmg) args=(--mac dmg) ;;
        zip) args=(--mac zip) ;;
        *)
          echo "Bilinmeyen macos formatı: $fmt (geçerli: dmg | zip)"
          exit 1
          ;;
      esac
      ;;
    *)
      echo "Bilinmeyen OS: $os (geçerli: linux | windows | macos)"
      exit 1
      ;;
  esac
  banner
  if [ "$FAST" = "1" ]; then
    echo "Hedef: OS=$os  Format=$fmt  Sürüm=$VERSION  Mod=HIZLI"
  else
    echo "Hedef: OS=$os  Format=$fmt  Sürüm=$VERSION  Mod=TAM"
  fi
  echo
  verify
  # Rust yan süreç (yerel AI) binary'si yoksa derle.
  if [ ! -x "$ROOT/native/ai-helper/target/release/ai-helper" ]; then
    echo "==> Rust yan süreç (ai-helper) derleniyor..."
    if ! (cd "$ROOT/native/ai-helper" && cargo build --release) >>"$log" 2>&1; then
      echo "HATA: Rust yan süreç derlenemedi. Tam çıktı:"
      tail -n 60 "$log"
      exit 1
    fi
    echo "==> Rust yan süreç hazır."
  fi
  echo "==> Derleniyor..."
  local start=$SECONDS
  if ! (cd "$ROOT" && npm --silent run build) >>"$log" 2>&1; then
    echo "HATA: derleme başarısız. Tam çıktı:"
    cat "$log"
    exit 1
  fi
  echo "==> Derlendi ($((SECONDS - start))sn). Paketleniyor..."
  start=$SECONDS
  # Eski/yarım kalmış paketleme sahnesi app-builder'ın sağlıksız duruma
  # düşmesine yol açabilir (AppImage sahnesinde "dosya yok" hatası); paketlemeye
  # temiz bir sahne ile başla.
  clean_pkg_stage() {
    rm -rf "$ROOT"/dist/__* "$ROOT"/dist/*-unpacked 2>/dev/null || true
  }
  clean_pkg_stage
  local attempt=1
  # DEBUG=1: app-builder'ın (mksquashfs komutu, sahne adımları) tam izi loga düşer.
  while ! (cd "$ROOT" && DEBUG=1 npx electron-builder "${args[@]}") >>"$log" 2>&1; do
    if [ "$attempt" -ge 2 ]; then
      echo "HATA: paketleme başarısız. Son 80 satır:"
      tail -n 80 "$log"
      echo "(Tam log: $log)"
      exit 1
    fi
    attempt=$((attempt + 1))
    echo "==> Paketleme turu başarısız oldu; sahne temizlenip bir kez daha deneniyor..."
    clean_pkg_stage
    : > "$log"
  done
  echo "==> Bitti ($((SECONDS - start))sn). Paketler: $ROOT/dist/"
}

interactive() {
  banner
  echo
  echo "Hedef işletim sistemi seç:"
  select os_choice in "Linux" "Windows" "macOS" "Vazgeç"; do
    case "$os_choice" in
      Linux)   OS="linux"; break ;;
      Windows) OS="windows"; break ;;
      macOS)   OS="macos"; break ;;
      Vazgeç|"") echo "Vazgeçildi."; exit 0 ;;
      *) echo "Geçersiz seçim, tekrar dene." ;;
    esac
  done

  echo
  case "$OS" in
    linux)
      echo "Paket formatı seç:"
      select f in "AppImage (.AppImage)" "DEB (.deb)" "RPM (.rpm)" "tar.gz (.tar.gz)" "Vazgeç"; do
        case "$REPLY" in
          1) FMT="appimage"; break ;;
          2) FMT="deb"; break ;;
          3) FMT="rpm"; break ;;
          4) FMT="targz"; break ;;
          5|"") echo "Vazgeçildi."; exit 0 ;;
          *) echo "Geçersiz seçim, tekrar dene." ;;
        esac
      done
      ;;
    windows)
      echo "Paket formatı seç:"
      select f in "NSIS kurulum (.exe)" "Portable (.exe)" "ZIP (.zip)" "Vazgeç"; do
        case "$REPLY" in
          1) FMT="nsis"; break ;;
          2) FMT="portable"; break ;;
          3) FMT="zip"; break ;;
          4|"") echo "Vazgeçildi."; exit 0 ;;
          *) echo "Geçersiz seçim, tekrar dene." ;;
        esac
      done
      ;;
    macos)
      echo "Paket formatı seç:"
      select f in "DMG (.dmg)" "ZIP (.zip)" "Vazgeç"; do
        case "$REPLY" in
          1) FMT="dmg"; break ;;
          2) FMT="zip"; break ;;
          3|"") echo "Vazgeçildi."; exit 0 ;;
          *) echo "Geçersiz seçim, tekrar dene." ;;
        esac
      done
      ;;
  esac

  build_target "$OS" "$FMT"
}

# ---- argüman yönlendirme ----
build_main() {
  case "${1:-}" in
    "") interactive ;;
    -h|--help|help) usage ;;
    -l|--list|list) list_targets ;;
    linux|windows|macos|darwin)
      if [ $# -lt 2 ]; then
        echo "Format eksik. Örnek: ./file --build $1 <format>"
        list_targets
        exit 1
      fi
      build_target "$1" "$2"
      ;;
    *)
      echo "Bilinmeyen komut: $1"
      echo
      usage
      exit 1
      ;;
  esac
}

case "${1:-}" in
  "")
    run_app
    ;;
  --build)
    shift
    build_main "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  -l|--list|list)
    list_targets
    ;;
  --install|install)
    do_install
    ;;
  --uninstall|uninstall)
    do_uninstall
    ;;
  --version|-v)
    echo "file $VERSION"
    ;;
  --)
    shift
    run_app "$@"
    ;;
  linux|windows|macos|darwin)
    if [ $# -lt 2 ]; then
      echo "Format eksik. Örnek: ./file $1 <format>"
      list_targets
      exit 1
    fi
    build_target "$1" "$2"
    ;;
  *)
    # Rezerve edilmemiş her argüman uygulamaya gider.
    run_app "$@"
    ;;
esac
