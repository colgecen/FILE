#!/usr/bin/env bash
#
# file — etkileşimli üretim/paket derleme aracı
#
# Kullanım:
#   ./file                      -> etkileşimli menü (OS seç -> format seç -> derle)
#   ./file --list               -> tüm derleme seçeneklerini listele
#   ./file linux appimage       -> hızlı derle (argümanlı, menüsüz)
#   ./file --tam linux appimage  -> tam derle (doğrulama zincirli)
#   ./file windows portable
#   ./file macos dmg
#   ./file --install            -> ~/.local/bin'e sembolik bağ kur,
#                                  sonra her klasörden `file` yazman yeterli
#   ./file --help               -> yardım
#
# Geçerli hedefler (package.json > build alanıyla birebir):
#   linux   : appimage | deb | rpm | targz
#   windows : nsis | portable | zip
#   macos   : dmg | zip
#
set -euo pipefail

# ROOT = bu scriptin bulunduğu repo kökü. $0 symlink (örn. ~/.local/bin)
# üzerinden çağrılabilir, o yüzden tüm symlink'ler çözülür.
resolve_root() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}
ROOT="$(resolve_root)"

export PATH="$HOME/node/bin:$PATH"

VERSION="$(node -p "require('$ROOT/package.json').version" 2>/dev/null || echo bilinmiyor)"

# Hızlı mod varsayılandır: doğrulama zinciri atlanır.
# --tam verilirse typecheck + lint + test de çalışır.
FAST=1
ARGS=()
for a in "$@"; do
  case "$a" in
    --tam) FAST=0 ;;
    --fast|-f) FAST=1 ;;
    *) ARGS+=("$a") ;;
  esac
done
if [ "${#ARGS[@]}" -gt 0 ]; then
  set -- "${ARGS[@]}"
else
  set --
fi

banner() {
  echo "=============================================="
  echo "  Derleme araci  v$VERSION"
  echo "=============================================="
}

usage() {
  banner
  echo
  echo "Kullanım:"
  echo "  ./file                      Etkileşimli menü (hızlı)"
  echo "  ./file <os> <format>        Direkt hızlı derle"
  echo "  ./file --tam <os> <format>  Tam derle (doğrulama zincirli)"
  echo "  ./file --list               Seçenekleri listele"
  echo "  ./file --install            Komutu sisteme kur (her yerden 'file')"
  echo "  ./file --help               Bu yardım"
  echo
  echo "Hedefler:"
  echo "  linux   : appimage | deb | rpm | targz"
  echo "  windows : nsis | portable | zip"
  echo "  macos   : dmg | zip"
  echo
  echo "Örnekler:"
  echo "  ./file linux appimage"
  echo "  ./file --tam linux appimage"
  echo "  ./file windows portable"
  echo
  echo "Not: varsayılan hızlıdır (doğrulama atlanır). --tam ile typecheck"
  echo "+ lint + test zinciri de çalışır. Çıktı kısa tutulur; hata olursa"
  echo "tam log ekrana dökülür."
  echo "Windows/macOS paketleri Linux üstünde ek araç isteyebilir (wine vb.)."
}

list_targets() {
  echo "linux   : appimage | deb | rpm | targz"
  echo "windows : nsis | portable | zip"
  echo "macos   : dmg | zip"
}

do_install() {
  local bindir="$HOME/.local/bin"
  mkdir -p "$bindir"
  ln -sf "$ROOT/file" "$bindir/file"
  echo "Kuruldu: $bindir/file -> $ROOT/file"
  case ":$PATH:" in
    *":$bindir:"*) echo "PATH zaten '$bindir' içeriyor. Artık her klasörden 'file' yazabilirsin." ;;
    *)
      echo "NOT: '$bindir' PATH'te yok. Şu satırı ~/.bashrc'ye ekle:"
      echo "  export PATH=\"\$HOME/.local/bin:\$PATH\""
      echo "Sonra yeni terminal aç ya da: source ~/.bashrc"
      ;;
  esac
}

# verify: paketleme öncesi doğrulama zinciri (hızlı modda atlanır)
verify() {
  if [ "$FAST" = "1" ]; then
    echo "==> Hızlı mod: doğrulama atlandı."
    return 0
  fi
  echo "==> Doğrulama zinciri çalışıyor (typecheck + lint + test)..."
  (cd "$ROOT" && npm run typecheck)
  (cd "$ROOT" && npm run lint)
  (cd "$ROOT" && npm test)
  echo "==> Doğrulama temiz."
}

build_target() {
  local os="$1" fmt="$2"
  local log="/tmp/file-derleme.log"
  : > "$log"
  # Önce hedefi doğrula; boşa derleme çalışmasın.
  local args=()
  case "$os" in
    linux)
      case "$fmt" in
        appimage) args=(--linux AppImage) ;;
        deb) args=(--linux deb) ;;
        rpm) args=(--linux rpm) ;;
        targz) args=(--linux tar.gz) ;;
        *)
          echo "Bilinmeyen linux formatı: $fmt (geçerli: appimage | deb | rpm | targz)"
          exit 1
          ;;
      esac
      ;;
    windows)
      case "$fmt" in
        nsis) args=(--win nsis) ;;
        portable) args=(--win portable) ;;
        zip) args=(--win zip) ;;
        *)
          echo "Bilinmeyen windows formatı: $fmt (geçerli: nsis | portable | zip)"
          exit 1
          ;;
      esac
      ;;
    macos|darwin)
      case "$fmt" in
        dmg) args=(--mac dmg) ;;
        zip) args=(--mac zip) ;;
        *)
          echo "Bilinmeyen macos formatı: $fmt (geçerli: dmg | zip)"
          exit 1
          ;;
      esac
      ;;
    *)
      echo "Bilinmeyen OS: $os (geçerli: linux | windows | macos)"
      exit 1
      ;;
  esac
  banner
  if [ "$FAST" = "1" ]; then
    echo "Hedef: OS=$os  Format=$fmt  Sürüm=$VERSION  Mod=HIZLI"
  else
    echo "Hedef: OS=$os  Format=$fmt  Sürüm=$VERSION  Mod=TAM"
  fi
  echo
  verify
  echo "==> Derleniyor..."
  local start=$SECONDS
  if ! (cd "$ROOT" && npm --silent run build) >>"$log" 2>&1; then
    echo "HATA: derleme başarısız. Tam çıktı:"
    cat "$log"
    exit 1
  fi
  echo "==> Derlendi ($((SECONDS - start))sn). Paketleniyor..."
  start=$SECONDS
  if ! (cd "$ROOT" && npx electron-builder "${args[@]}") >>"$log" 2>&1; then
    echo "HATA: paketleme başarısız. Son 80 satır:"
    tail -n 80 "$log"
    exit 1
  fi
  echo "==> Bitti ($((SECONDS - start))sn). Paketler: $ROOT/dist/"
}

interactive() {
  banner
  echo
  echo "Hedef işletim sistemi seç:"
  select os_choice in "Linux" "Windows" "macOS" "Vazgeç"; do
    case "$os_choice" in
      Linux)   OS="linux"; break ;;
      Windows) OS="windows"; break ;;
      macOS)   OS="macos"; break ;;
      Vazgeç|"") echo "Vazgeçildi."; exit 0 ;;
      *) echo "Geçersiz seçim, tekrar dene." ;;
    esac
  done

  echo
  case "$OS" in
    linux)
      echo "Paket formatı seç:"
      select f in "AppImage (.AppImage)" "DEB (.deb)" "RPM (.rpm)" "tar.gz (.tar.gz)" "Vazgeç"; do
        case "$REPLY" in
          1) FMT="appimage"; break ;;
          2) FMT="deb"; break ;;
          3) FMT="rpm"; break ;;
          4) FMT="targz"; break ;;
          5|"") echo "Vazgeçildi."; exit 0 ;;
          *) echo "Geçersiz seçim, tekrar dene." ;;
        esac
      done
      ;;
    windows)
      echo "Paket formatı seç:"
      select f in "NSIS kurulum (.exe)" "Portable (.exe)" "ZIP (.zip)" "Vazgeç"; do
        case "$REPLY" in
          1) FMT="nsis"; break ;;
          2) FMT="portable"; break ;;
          3) FMT="zip"; break ;;
          4|"") echo "Vazgeçildi."; exit 0 ;;
          *) echo "Geçersiz seçim, tekrar dene." ;;
        esac
      done
      ;;
    macos)
      echo "Paket formatı seç:"
      select f in "DMG (.dmg)" "ZIP (.zip)" "Vazgeç"; do
        case "$REPLY" in
          1) FMT="dmg"; break ;;
          2) FMT="zip"; break ;;
          3|"") echo "Vazgeçildi."; exit 0 ;;
          *) echo "Geçersiz seçim, tekrar dene." ;;
        esac
      done
      ;;
  esac

  build_target "$OS" "$FMT"
}

# ---- argüman yönlendirme ----
if [ $# -eq 0 ]; then
  interactive
  exit 0
fi

case "${1:-}" in
  -h|--help|help)
    usage
    ;;
  -l|--list|list)
    list_targets
    ;;
  --install|install)
    do_install
    ;;
  --version|-v)
    echo "file $VERSION"
    ;;
  linux|windows|macos|darwin)
    if [ $# -lt 2 ]; then
      echo "Format eksik. Örnek: ./file $1 <format>"
      list_targets
      exit 1
    fi
    build_target "$1" "$2"
    ;;
  *)
    echo "Bilinmeyen komut: $1"
    echo
    usage
    exit 1
    ;;
esac
