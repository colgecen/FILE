{
  "name": "file",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.js",
  "description": "Keyboard-first desktop editor — Electron, Monaco & local AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colgecen/FILE.git"
  },
  "bugs": {
    "url": "https://github.com/colgecen/FILE/issues"
  },
  "homepage": "https://github.com/colgecen/FILE#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "lint": "eslint electron src --report-unused-disable-directives",
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p electron/tsconfig.json",
    "typecheck:web": "tsc --noEmit",
