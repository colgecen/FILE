{
  "name": "file",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.js",
  "description": "Keyboard-first desktop editor — Electron, Monaco & local AI",
  "author": "colgecen <alperencolgecen@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colgecen/FILE.git"
  },
  "bugs": {
    "url": "https://github.com/colgecen/FILE/issues"
  },
  "homepage": "https://github.com/colgecen/FILE#readme",
  "build": {
    "appId": "com.colgecen.file",
    "productName": "FILE",
    "copyright": "Copyright © 2026 colgecen",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] },
        { "target": "tar.gz", "arch": ["x64"] }
      ],
        "category": "Development"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder --linux --win --mac",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "lint": "eslint electron src --report-unused-disable-directives",
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p electron/tsconfig.json",
    "typecheck:web": "tsc --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@huggingface/transformers": "^4.2.0",
    "monaco-editor": "^0.52.2",
    "xterm": "^5.3.0"
  },
  "allowScripts": {
    "@homebridge/node-pty-prebuilt-multiarch@0.14.1": true
  }
}
